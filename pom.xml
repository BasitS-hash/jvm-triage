<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.basit</groupId>
  <artifactId>jvm-triage</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <name>jvm-triage</name>
  <description>Offline triage for JVM heap dumps (HPROF) and thread dumps.</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.3</junit.version>
    <!--
      Tests tagged "large" build a multi-gibibyte fixture on disk. They are skipped by
      default so `mvn test` stays a one-second command, and enabled by -Plarge-dumps.
      A tag plus a profile rather than an @EnabledIfSystemProperty: the exclusion is
      visible in the build file, so nobody has to read the test to find out why it never
      ran, and CI opts in by naming the profile rather than by knowing a property.
    -->
    <excludedTestGroups>large</excludedTestGroups>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <excludedGroups>${excludedTestGroups}</excludedGroups>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <finalName>jvm-triage</finalName>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>dev.basit.jvmtriage.Main</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.13</version>
        <executions>
          <execution>
            <goals><goal>prepare-agent</goal></goals>
            <configuration>
              <!--
                Scope instrumentation to our own classes. Without this the agent
                also tries to instrument JDK internals, which fails loudly on a
                JDK newer than the JaCoCo release knows about (class file major
                version 70 on JDK 26) — noise that looks like a real build error.
              -->
              <includes>
                <include>dev/basit/**</include>
              </includes>
            </configuration>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals><goal>report</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Runs the whole suite including the tests tagged "large". Needs several GiB of free
      space under the temp directory; the tests check and skip themselves if it is not
      there. CI runs this as a separate job.
    -->
    <profile>
      <id>large-dumps</id>
      <properties>
        <excludedTestGroups/>
      </properties>
    </profile>
  </profiles>
</project>
